{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ],
      "dest": "/apple-app-site-association"
    },
    {
      "src": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ],
      "dest": "/.well-known/assetlinks.json"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
